{
  "name": "@nishant-bage/tablecraft",
  "version": "0.1.0",
  "description": "A typed React table with sorting, search, pagination, selection, and column visibility.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\""
  },
  "engines": {
    "node": ">=22.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
